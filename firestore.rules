rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- USER PRIVATE REPOSITORY ---
    // All user profiles, manifests, notes, and folders live under /users/{userId}
    match /users/{userId} {
      // Helper function to verify authenticated user ownership
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Wildcard fallback: Allow owner full read/write across all sub-paths
      allow read, write: if isOwner();

      // Explicit rules for Workspace Manifest: /users/{userId}/workspaces_manifest/{workspaceId}
      match /workspaces_manifest/{workspaceId} {
        allow read, write: if isOwner();
      }

      // Explicit rules for Workspaces: /users/{userId}/workspaces/{workspaceId}
      match /workspaces/{workspaceId} {
        allow read, write: if isOwner();

        // Notes Subcollection: /users/{userId}/workspaces/{workspaceId}/notes/{noteId}
        match /notes/{noteId} {
          allow read, write: if isOwner();
        }

        // Folders Subcollection: /users/{userId}/workspaces/{workspaceId}/folders/{folderId}
        match /folders/{folderId} {
          allow read, write: if isOwner();
        }
      }
    }

    // Default fallback: Deny access to any unhandled root collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
