rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User data is stored under /users/{userId} and its subcollections (e.g. notes, folders)
    match /users/{userId}/{document=**} {
      // Allow read and write only if the request is from the authenticated owner
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny access to any other unhandled documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
